# Для вёрстки без Telegram раскомментируйте:
# LEAD_ADAPTER=mock
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Для GitHub Pages те же значения нужны как VITE_*, иначе форма на статике не дойдёт до бота:
# VITE_TELEGRAM_BOT_TOKEN=
# VITE_TELEGRAM_CHAT_ID=
# Если сайт на GitHub Pages, а API заявок на другом хосте:
# LEAD_CORS_ORIGIN=https://paulos99.github.io
